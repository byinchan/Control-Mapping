# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables (server-side only).

# Claude API key. Server-side only: never prefix it with NEXT_PUBLIC_.
# Leave unset to run in demo mode (saved suggestions for the 14 PUC sample controls).
ANTHROPIC_API_KEY=

# "live" (default) uses the Claude API when a key is set; "mock" uses the keyword-overlap mock mapper.
MAPPER=live

# Model for the mapping route (default: claude-haiku-5-5).
MAPPING_MODEL=claude-haiku-5-5

# Requests per IP per 10 minutes (default 20) and live model calls per UTC day (default 300).
MAPPING_RATE_LIMIT_PER_IP=20
MAPPING_DAILY_CALL_CAP=300
